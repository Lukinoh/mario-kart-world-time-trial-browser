{
  "globals": {
    "console": true,
    "performance": true,
    "document": true,
    "ImageData": true,
    "OffscreenCanvas": true,
    "HTMLElement": true,
    "navigator": true,
    "Image": true,
    "location": true,
    "URL": true,
    "Blob": true,
    "open": true,
    "DOMParser": true,
    "fetch": true,
    "crypto": true,
    "BroadcastChannel": true
  },
  "plugins": ["typescript", "unicorn", "oxc", "import", "node", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error",
    "nursery": "error"
  },
  "rules": {
    "eslint/arrow-body-style": ["off"],
    "eslint/capitalized-comments": "off",
    "eslint/func-style": "off",
    "eslint/id-length": [
      "error",
      {
        "exceptions": ["_", "r", "g", "b", "a", "x", "y", "P", "T", "v", "S", "O", "K"]
      }
    ],
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-statements": "off",
    "eslint/max-params": ["error", 4],
    "eslint/no-await-in-loop": "off",
    "eslint/no-console": ["error", { "allow": ["info", "warn", "error"] }],
    "eslint/no-empty-function": ["error", { "allow": ["privateConstructors"] }],
    "eslint/no-magic-numbers": "off",
    "eslint/no-ternary": "off",
    "eslint/no-empty-pattern": "off",
    "eslint/no-undefined": "off",
    "eslint/sort-keys": "off",
    "eslint/operator-assignment": "off",

    "import/consistent-type-specifier-style": "off",
    "import/group-exports": "off",
    "import/no-default-export": "off",
    "import/no-named-export": "off",
    "import/no-namespace": ["error", { "ignore": ["valibot"] }],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["solid-devtools", "simpledotcss/simple.min.css", "./canvas-shim", "./domains/ui/global-styles"]
      }
    ],
    "import/prefer-default-export": "off",
    "import/unambiguous": "off",
    "import/exports-last": "off",
    "import/max-dependencies": ["error", { "max": 24 }],

    // Jest is not used in this repository
    "jest/require-hook": "off",
    "jest/max-expects": "off",
    "jest/no-standalone-expect": "off",
    "jest/require-to-throw-message": "off",

    "oxc/no-async-await": "off",
    "oxc/no-map-spread": "off",
    "oxc/no-optional-chaining": "off",
    "oxc/no-rest-spread-properties": "off",

    "promise/prefer-await-to-callbacks": "off",
    "promise/spec-only": ["error", { "allowedMethods": ["try"] }],

    "typescript/array-type": ["error", { "default": "generic" }],
    "typescript/promise-function-async": "off",
    "typescript/no-unsafe-type-assertion": "warn",
    "typescript/no-misused-promises": ["error", { "checksVoidReturn": false }],
    // Ideally, we should ignoreStatic, however, it seems the rule does not work as expected
    "typescript/unbound-method": ["off", { "ignoreStatic": true }],

    "unicorn/no-array-for-each": "off",
    "unicorn/no-useless-undefined": "off",
    "unicorn/no-array-reduce": "off",

    "vitest/consistent-test-it": ["error", { "fn": "test" }]
  }
}
