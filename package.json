{
  "name": "mario-kart-world-time-trial-browser",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "pnpm run --stream /^check:.*/",
    "check:format": "prettier . --cache --check --experimental-cli",
    "check:lint": "oxlint --type-aware",
    "check:types": "tsc",
    "dev": "vite",
    "fix": "pnpm run --stream /^fix:/",
    "fix:format": "prettier . --cache --write --experimental-cli",
    "fix:lint": "oxlint --type-aware --fix",
    "prepare": "husky",
    "serve": "vite preview"
  },
  "dependencies": {
    "@blazediff/gmsd": "1.7.0",
    "@blazediff/ssim": "1.7.0",
    "@emotion/css": "11.13.5",
    "@henrygd/queue": "1.2.0",
    "date-and-time": "4.1.1",
    "idb-keyval": "6.2.2",
    "remeda": "2.32.0",
    "simpledotcss": "2.3.7",
    "solid-js": "1.9.10"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "0.1.2",
    "git-conventional-commits": "2.8.0",
    "husky": "9.1.7",
    "oxlint": "1.31.0",
    "oxlint-tsgolint": "0.8.3",
    "prettier": "3.7.3",
    "prettier-plugin-packagejson": "2.5.20",
    "solid-devtools": "0.34.4",
    "typescript": "5.9.3",
    "vite": "7.2.6",
    "vite-plugin-solid": "2.11.10"
  }
}
