{
  "name": "mario-kart-world-time-trial-browser",
  "version": "1.3.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "pnpm run --stream /^check:.*/",
    "check:format": "prettier . --cache --check --experimental-cli",
    "check:lint": "oxlint --type-aware",
    "check:types": "tsc",
    "dev": "vite",
    "fix": "pnpm run --stream /^fix:/",
    "fix:format": "prettier . --cache --write --experimental-cli",
    "fix:lint": "oxlint --type-aware --fix",
    "prepare": "husky && playwright install chromium",
    "release": "node release.ts",
    "release:changelog": "git-conventional-commits changelog",
    "release:version": "git-conventional-commits version",
    "serve": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@henrygd/queue": "1.2.0",
    "@solidjs/router": "0.15.4",
    "date-and-time": "4.2.0",
    "idb-keyval": "6.2.2",
    "remeda": "2.33.6",
    "simpledotcss": "2.3.7",
    "solid-js": "1.9.11",
    "valibot": "1.2.0",
    "worker-timers": "8.0.30"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "0.1.3",
    "@types/node": "24.10.13",
    "@vitest/browser-playwright": "4.0.18",
    "canvas": "3.2.1",
    "git-conventional-commits": "2.8.0",
    "husky": "9.1.7",
    "jsdom": "28.0.0",
    "oxlint": "1.47.0",
    "oxlint-tsgolint": "0.12.2",
    "playwright": "1.58.2",
    "prettier": "3.8.1",
    "prettier-plugin-packagejson": "3.0.0",
    "sharp": "0.34.5",
    "solid-devtools": "0.34.5",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-plugin-singlefile": "2.3.0",
    "vite-plugin-solid": "2.11.10",
    "vitest": "4.0.18"
  },
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc"
}
