{
  "name": "mario-kart-world-time-trial-browser",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "pnpm run --stream /^check:.*/",
    "check:format": "prettier . --cache --check --experimental-cli",
    "check:lint": "oxlint --type-aware",
    "check:types": "tsc",
    "dev": "vite",
    "fix": "pnpm run --stream /^fix:/",
    "fix:format": "prettier . --cache --write --experimental-cli",
    "fix:lint": "oxlint --type-aware --fix",
    "prepare": "husky && playwright install",
    "serve": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@henrygd/queue": "1.2.0",
    "@solidjs/router": "0.15.4",
    "date-and-time": "4.2.0",
    "idb-keyval": "6.2.2",
    "remeda": "2.33.4",
    "simpledotcss": "2.3.7",
    "solid-js": "1.9.10",
    "valibot": "1.2.0",
    "worker-timers": "8.0.29"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "0.1.3",
    "@types/node": "24.10.9",
    "@vitest/browser-playwright": "4.0.17",
    "canvas": "3.2.1",
    "git-conventional-commits": "2.8.0",
    "husky": "9.1.7",
    "jsdom": "27.4.0",
    "oxlint": "1.39.0",
    "oxlint-tsgolint": "0.11.1",
    "playwright": "1.57.0",
    "prettier": "3.8.0",
    "prettier-plugin-packagejson": "2.5.22",
    "sharp": "0.34.5",
    "solid-devtools": "0.34.4",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-plugin-singlefile": "2.3.0",
    "vite-plugin-solid": "2.11.10",
    "vitest": "4.0.17"
  }
}
