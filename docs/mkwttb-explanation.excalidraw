    {
      "id": "MAVlTV4Zn6xIIam4P_pD9",
      "type": "text",
      "x": 18528.679284247315,
      "y": -6115.0081954798,
      "width": 691.2985065445117,
      "height": 63.72691497994427,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "Ah8xC5lCuPNoh2-o5h_gG",
      "index": "bAh",
      "roundness": null,
      "seed": 1431289582,
      "version": 3489,
      "versionNonce": 2128342002,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1771085661666,
      "link": null,
      "locked": false,
      "text": "Shrooms and Tracks reference images where fully colored => High bundle size ~ 5Mb\nThe processing of all inputs was \"slow\" ~35ms\nTracks identification was not always correct (CrownCity identified as DK Pass)",
      "fontSize": 16.993843994651805,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Shrooms and Tracks reference images where fully colored => High bundle size ~ 5Mb\nThe processing of all inputs was \"slow\" ~35ms\nTracks identification was not always correct (CrownCity identified as DK Pass)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "sBa2mujaotgwl_2hlNarP",
      "type": "text",
      "x": 18614.2209203354,
      "y": -5999.377395824784,
      "width": 602.6158765018281,
      "height": 21.24230499331476,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
