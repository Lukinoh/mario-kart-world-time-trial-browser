      "index": "b52C",
      "roundness": null,
      "seed": 1980471472,
      "version": 3610,
      "versionNonce": 2016238616,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771060128173,
      "link": null,
      "locked": false,
      "text": "Track images are also stored as black and white images\nShroom images are smaller (I put in black only the background)\nThe processing of all inputs way quicker ~10ms\nNo more wrong identification",
      "fontSize": 37.158344918902834,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Track images are also stored as black and white images\nShroom images are smaller (I put in black only the background)\nThe processing of all inputs way quicker ~10ms\nNo more wrong identification",
      "autoResize": true,
      "lineHeight": 1.25
    },
