      "versionNonce": 949439256,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771060128173,
      "link": null,
      "locked": false,
      "text": "The last problem was the biggest one, so I looked for another approach",
      "fontSize": 37.158344918902834,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The last problem was the biggest one, so I looked for another approach",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WVoFsL_xqMvsafkXlDsWy",
      "type": "text",
      "x": -682.8301068610622,
      "y": 3195.618548171225,
      "width": 286.61469291458593,
      "height": 65.02710360807997,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
