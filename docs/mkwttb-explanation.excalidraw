    },
    {
      "id": "WbAlsTTajhkfyjB2pN1QN",
      "type": "text",
      "x": -683.5676056958471,
      "y": 3833.965024115332,
      "width": 1133.5314823443484,
      "height": 185.7917245945142,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
