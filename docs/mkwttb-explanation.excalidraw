      "versionNonce": 1579058222,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1771085661666,
      "link": null,
      "locked": false,
      "text": "The last problem was the biggest one, so I looked for another approach",
      "fontSize": 16.993843994651805,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The last problem was the biggest one, so I looked for another approach",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "bg3I8UZnJMmNhu1aGRCfC",
      "type": "text",
      "x": 19341.27448887882,
      "y": -6407.994429422747,
      "width": 131.07917988800787,
      "height": 29.739226990640663,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
