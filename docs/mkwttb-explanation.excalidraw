      "boundElements": [],
      "updated": 1771060020663,
      "link": null,
      "locked": false,
      "text": "The state \"isReset\" was never triggered during the\nstart of the race, hence the application was not working.\nBecause the shrooms, coins, laps were wrongly\ninterpreted.",
      "fontSize": 82.71997070312504,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The state \"isReset\" was never triggered during the start of the race, hence the application was not working.\nBecause the shrooms, coins, laps were wrongly interpreted.",
