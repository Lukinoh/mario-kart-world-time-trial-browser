      "type": "text",
      "x": 9136.193005411495,
      "y": 874.6172469335957,
      "width": 2256.9835151308225,
      "height": 817.1965017241798,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
