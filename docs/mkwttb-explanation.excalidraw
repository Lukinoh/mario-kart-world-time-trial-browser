    {
      "id": "u5sLZ4ACD1Nnauu6D9xn7",
      "type": "text",
      "x": -2459.6319241924834,
      "y": 3836.255448260967,
      "width": 1511.5772721102762,
      "height": 139.34379344588564,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "X_S3eCrWcJqPieVqQYvFF",
      "index": "b52",
      "roundness": null,
      "seed": 80702544,
      "version": 3389,
      "versionNonce": 94948888,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771060128173,
      "link": null,
      "locked": false,
      "text": "Shrooms and Tracks reference images where fully colored => High bundle size ~ 5Mb\nThe processing of all inputs was \"slow\" ~35ms\nTracks identification was not always correct (CrownCity identified as DK Pass)",
      "fontSize": 37.158344918902834,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Shrooms and Tracks reference images where fully colored => High bundle size ~ 5Mb\nThe processing of all inputs was \"slow\" ~35ms\nTracks identification was not always correct (CrownCity identified as DK Pass)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_AzUrP4QVb975fEKXuFxp",
      "type": "text",
      "x": -2272.5885678048085,
      "y": 4089.091071453803,
      "width": 1317.6658912314963,
      "height": 46.44793114862855,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
