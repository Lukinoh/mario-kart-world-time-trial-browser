      "isDeleted": true,
      "boundElements": [],
      "updated": 1771085661666,
      "link": null,
      "locked": false,
      "text": "Approach 2",
      "fontSize": 23.791381592512533,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Approach 2",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "zIlHJPRHzCZ-Hlm2sybtK",
      "type": "text",
      "x": 19341.27448887882,
      "y": -6307.345256810283,
      "width": 364.09310758541494,
      "height": 84.96921997325904,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "Ah8xC5lCuPNoh2-o5h_gG",
      "index": "bAk",
      "roundness": null,
      "seed": 1711390126,
      "version": 4216,
      "versionNonce": 341429870,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1771085661666,
      "link": null,
      "locked": false,
      "text": "Use the mean squared error algorithm.\nUltra-basic algorithm\nIt compares the \"error\" between two pixels.\nThe image with less errors is the candidate",
      "fontSize": 16.993843994651808,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Use the mean squared error algorithm.\nUltra-basic algorithm\nIt compares the \"error\" between two pixels.\nThe image with less errors is the candidate",
      "autoResize": true,
      "lineHeight": 1.25
    },
