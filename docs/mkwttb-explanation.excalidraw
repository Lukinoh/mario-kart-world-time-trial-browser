      "lineHeight": 1.25
    },
    {
      "id": "mpvhYtrLx-5-FCKUouM_A",
      "type": "text",
      "x": 19340.937204207723,
      "y": -6116.055688598707,
      "width": 518.4046064491679,
      "height": 84.96921997325904,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "Ah8xC5lCuPNoh2-o5h_gG",
      "index": "bAn",
      "roundness": null,
      "seed": 1715156078,
      "version": 3710,
      "versionNonce": 1343445298,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1771085661666,
      "link": null,
      "locked": false,
      "text": "Track images are also stored as black and white images\nShroom images are smaller (I put in black only the background)\nThe processing of all inputs way quicker ~10ms\nNo more wrong identification",
      "fontSize": 16.993843994651805,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Track images are also stored as black and white images\nShroom images are smaller (I put in black only the background)\nThe processing of all inputs way quicker ~10ms\nNo more wrong identification",
      "autoResize": true,
      "lineHeight": 1.25
    },
