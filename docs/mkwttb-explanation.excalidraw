      "isDeleted": false,
      "boundElements": [],
      "updated": 1771060128173,
      "link": null,
      "locked": false,
      "text": "Approach 2",
      "fontSize": 52.02168288646398,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Approach 2",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "yvm2yt8y1Qz-ujgJFz8ma",
      "type": "text",
      "x": -682.8301068610622,
      "y": 3415.6956933370325,
      "width": 796.1175398874932,
      "height": 185.7917245945142,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "X_S3eCrWcJqPieVqQYvFF",
      "index": "b526",
      "roundness": null,
      "seed": 2060442288,
      "version": 4116,
      "versionNonce": 1071736088,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771060128173,
      "link": null,
      "locked": false,
      "text": "Use the mean squared error algorithm.\nUltra-basic algorithm\nIt compares the \"error\" between two pixels.\nThe image with less errors is the candidate",
      "fontSize": 37.158344918902834,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Use the mean squared error algorithm.\nUltra-basic algorithm\nIt compares the \"error\" between two pixels.\nThe image with less errors is the candidate",
      "autoResize": true,
      "lineHeight": 1.25
    },
