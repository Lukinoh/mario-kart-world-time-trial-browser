      "index": "b4P",
      "roundness": null,
      "seed": 1815780016,
      "version": 2057,
      "versionNonce": 545619304,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771060020663,
      "link": null,
      "locked": false,
      "text": "As you can see, the track part is a slightly\ndifferent between SDR and HDR version.\n\nBut, I need to be sure the detection\nworks for every tracks, even if I do change or adaption.\nAnd to make sure I need screenshots for my tests.\n\nThat's why I need you (ZippyN1)!",
      "fontSize": 81.71965017241799,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "As you can see, the track part is a slightly\ndifferent between SDR and HDR version.\n\nBut, I need to be sure the detection\nworks for every tracks, even if I do change or adaption.\nAnd to make sure I need screenshots for my tests.\n\nThat's why I need you (ZippyN1)!",
      "autoResize": true,
      "lineHeight": 1.25
    },
